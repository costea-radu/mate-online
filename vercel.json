{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/ai-ingest?action=process",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/ai-notify?action=scan",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/account-cleanup?action=run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/seo-cron?action=snapshot",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/seo-cron?action=autorun",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/social-cron?action=publish",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/social-cron?action=metrics",
      "schedule": "30 7 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/page-meta?route=/"
    },
    {
      "source": "/:page(evaluare-nationala|manuale|rezolvari|discutii|profesor-virtual|tema|biblioteca-utilizatorilor|preturi|faq|despre-noi|contact|politica-confidentialitate|termeni-conditii|politica-cookies|politica-retur)",
      "destination": "/api/page-meta?route=/:page"
    },
    {
      "source": "/bacalaureat",
      "destination": "/api/page-meta?route=/bacalaureat"
    },
    {
      "source": "/bacalaureat/:profil",
      "destination": "/api/page-meta?route=/bacalaureat/:profil"
    },
    {
      "source": "/clase/:grade",
      "destination": "/api/page-meta?route=/clase/:grade"
    },
    {
      "source": "/rezolvari/:slug",
      "destination": "/api/page-meta?route=/rezolvari/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300,
      "includeFiles": "api/_lib/**"
    }
  }
}
