# =====================================================================
# Profesor Virtual (AI) — variabile de mediu
# Adaugă-le în Vercel → Project → Settings → Environment Variables
# (NU în fișiere comise în git). Cheile fără prefix VITE_ rămân pe server.
# =====================================================================

# ─── OBLIGATORIU: furnizorul LLM (default OpenAI) ────────────────────
# O singură cheie OpenAI acoperă și chat, și embeddings:
OPENAI_API_KEY=sk-...

# ─── OPȚIONAL: control fin / alt furnizor compatibil OpenAI ──────────
# Chat (generare text). Lasă gol pentru OpenAI default.
# AI_CHAT_BASE_URL=https://api.openai.com/v1
# AI_CHAT_API_KEY=sk-...
# AI_CHAT_MODEL=gpt-4o-mini

# Foto-rezolvare (model cu vedere — citește enunțul din poza elevului).
# Default: gpt-5.6-terra (scrisul de mână și formulele cer un model bun la vedere;
# o transcriere greșită strică tot ce urmează). NU mai moștenește modelul de chat.
# AI_VISION_MODEL=gpt-5.6-terra

# Generarea de teste/exerciții + corectarea fără barem. Default: gpt-5.6-sol.
# Acolo modelul calculează SINGUR, deci o greșeală ajunge direct cheie de răspuns.
# ATENȚIE la cost: ~30× față de gpt-4o-mini. Adminii sunt scutiți de bugete, dar
# elevii NU — vezi GHID_LIMITE_AI.md înainte să-l lași pe elevi.
# AI_GEN_CHAT_MODEL=gpt-5.6-sol

# Voce → text (fallback Whisper, doar când browserul nu suportă dictarea). Default: whisper-1.
# AI_STT_MODEL=whisper-1
# AI_STT_BASE_URL=https://api.openai.com/v1
# AI_STT_API_KEY=sk-...

# Embeddings (vectorizare pentru RAG). Lasă gol pentru OpenAI default.
# AI_EMBED_BASE_URL=https://api.openai.com/v1
# AI_EMBED_API_KEY=sk-...
# AI_EMBED_MODEL=text-embedding-3-small
# AI_EMBED_DIM=1536        # TREBUIE să fie 1536 pentru schema livrată (vezi ghidul)

# ─── OPȚIONAL: reglaje ───────────────────────────────────────────────
# AI_RATE_PER_HOUR=80      # câte cereri AI poate face un utilizator pe oră
# AI_FREE_ACTIONS=2        # câte acțiuni AI poate face un cont FĂRĂ abonament (apoi upsell)
# AI_INGEST_BATCH=20       # câte materiale se indexează per lot
# AI_SIGNING_SECRET=...    # secret pentru tokenul exercițiilor (default: service role key)
# AI_CRON_SECRET=...       # dacă folosești cron prin URL cu ?secret=...

# ─── Etapa 1 (AUDIT_AGENTI_AI.md) — valori implicite bune; schimbi doar dacă ai nevoie ──
# AI_PRACTICE_TOKEN_TTL=86400     # secunde: tokenul unui exercițiu de antrenament (răspuns+rezolvare) expiră după 24h
# AI_CORRECT_FORM_TTL=21600       # secunde: formularul semnat „Răspunde în chat" e valabil 6h
# AI_PDF_CACHE_RETRY_HOURS=24     # cache-ul ai_pdf_text reîncearcă asocierea test↔barem „negăsit" după atâtea ore
# Structured Outputs (json_schema strict) sunt pornite automat pe toate pipeline-urile JSON;
# dacă providerul le refuză (gateway vechi), codul coboară singur pe json_object — nimic de setat.

# ─── Bugete (ridicate pe 23 aug. 2026, o dată cu trecerea generării pe sol) ──────────────────
# Implicitele din cod: zi soft 2,5 lei · zi hard 6 lei · lună 12 lei (erau 0,8 / 2,5 / 6).
# Abonamentul e 50 lei/lună, deci plafonul lunar înseamnă 24% din el. Adminii sunt scutiți.
# AI_BUDGET_DAY_SOFT_LEI=2.5      # peste el: degradare pe modelul economic (NU blochează)
# AI_BUDGET_DAY_HARD_LEI=6        # peste el: 429 până la miezul nopții (ora României)
# AI_BUDGET_MONTH_LEI=12          # 30 de zile rulante; 0 = limita e dezactivată

# ─── Etapa 2 (AUDIT_AGENTI_AI.md) — corectitudine ────────────────────────────────────────────
# Modelul pentru EXPLICAȚIILE pas-cu-pas din chat (modurile tutor/explain/hint); asistentul general
# rămâne pe AI_CHAT_MODEL. Decizi cu `npm run eval -- --mode tutor --models gpt-4o-mini,gpt-5-mini`.
# AI_TUTOR_MODEL=gpt-5-mini
# Efortul de raționament la modelele gpt-5.x / o-series (minimal|low|medium|high). Nesetat → implicitul
# providerului. Se ignoră la modelele fără raționament.
# ATENȚIE: e GLOBAL — se aplică TUTUROR modelelor cu raționament, inclusiv lui gpt-5.6-sol la
# generare. `low` l-ar ieftini pe verificator, dar ar coborî și calitatea generării. Lasă-l nesetat.
# AI_REASONING_EFFORT=low
# Verificatorul independent al itemilor generați (teste de examen, exerciții interactive, meditații):
# AI_VERIFY_GEN=1                 # 0 = oprit (doar validarea structurală, fără al doilea apel)
# AI_VERIFY_MODEL=gpt-5-mini      # SETEAZĂ-L. Nesetat = modelul de generare (gpt-5.6-sol), deci sol
#                                 # verifică ce a scris sol: aceleași puncte oarbe, plus ~1,17 lei la
#                                 # fiecare 24 de itemi. gpt-5-mini face aceeași muncă cu ~0,11 lei (×10,6
#                                 # mai ieftin) și e alt model, deci dezacordurile lui chiar înseamnă ceva.
# AI_VERIFY_MAX_ITEMS=24          # câți itemi se verifică per generare (restul trec neverificați, „skipped" în raport)
# AI_VERIFY_CONCURRENCY=4         # apeluri de verificare în paralel
# AI_VERIFY_TIME_MS=90000         # buget de timp pentru verificare (ms) — peste el, itemii rămași nu se mai verifică
# AI_VERIFY_MEDITATII=evaluare,simulare,tema   # ce scopuri din meditații trec prin verificator (lista goală = niciunul)
# Paginile PDF către model (agentul PDF trimite pagina exercițiului ca fișier, nu doar textul extras):
# AI_PDF_VISION=1                 # 0 = oprit (doar textul, ca înainte)
# AI_PDF_PAGE_MAX_BYTES=1572864   # pagina extrasă peste această mărime nu se atașează
# AI_PDF_MAX_PAGES=20             # câte pagini se citesc/indexează din fiecare PDF

# ─── Etapa 3 (AUDIT_AGENTI_AI.md) — RAG real, unelte, figuri, repetiție ──────────────────────
# Rulează întâi migrările: supabase/ai_rag_v2.sql și supabase/meditatii_v3.sql.
# UNELTELE tutorelui (tool calling): calculate / check_equivalence / get_exercise / get_barem_item
# AI_TOOLS=1                      # 0 = oprit (modelul calculează singur, ca înainte)
# AI_TOOL_ROUNDS=4                # câte runde de apeluri de unelte sunt permise per răspuns
# FIGURI în chat ([[FIGURA:{...}]] desenate de src/lib/figureRender.js):
# AI_CHAT_FIGURES=1               # 0 = oprit
# CĂUTAREA HIBRIDĂ (RAG): pragul de similaritate pentru candidații DOAR vectoriali
# AI_RAG_MIN_SIM=0.25
# INDEXAREA: câte materiale per rulare de cron și cât timp are voie să dureze
# AI_INGEST_BATCH=20
# AI_INGEST_TIME_MS=60000
# REPETIȚIA PE ITEMI (SM-2, meditații):
# AI_SR_RETIRE_REPS=3             # câte reușite consecutive fac un exercițiu „învățat"
# AI_SR_MAX_DAYS=180              # intervalul maxim între două reluări

# =====================================================================
# EXEMPLE de alt furnizor (decomentează și completează):
#
# OpenRouter:
#   AI_CHAT_BASE_URL=https://openrouter.ai/api/v1
#   AI_CHAT_API_KEY=sk-or-...
#   AI_CHAT_MODEL=openai/gpt-4o-mini
#   (embeddings tot de la OpenAI: setează AI_EMBED_API_KEY separat)
#
# Groq (doar chat, foarte rapid):
#   AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
#   AI_CHAT_API_KEY=gsk_...
#   AI_CHAT_MODEL=llama-3.3-70b-versatile
#
# Azure OpenAI: setează AI_CHAT_BASE_URL către endpointul tău /openai/deployments/...
# =====================================================================

# =====================================================================
# SECURITATE / URL-uri (adăugate la reparație)
# =====================================================================
# Originea permisă pentru CORS pe rutele /api. Seteaz-o la domeniul tău
# în producție (altfel default '*' — orice origine). Ex:
# SITE_ORIGIN=https://examenmate.com

# URL-ul public al site-ului (pentru redirect-urile Stripe checkout/portal).
# Înlocuiește vechiul NEXT_PUBLIC_SITE_URL (proiectul e Vite, nu Next.js). Ex:
# SITE_URL=https://examenmate.com
